# Copy to .env for local development. .env is gitignored and MUST NOT be
# committed — see Factor III (Config) in README.md. In deployed environments
# these are real environment variables (Docker Compose `environment:` /
# Kubernetes Secret+ConfigMap via the Helm chart), never a file.

APP_NAME=go-lang-template
ENVIRONMENT=local
LOG_LEVEL=debug
PORT=8000

# Factor IV (Backing services): point this at whatever Postgres you have —
# swapping it for a different host/instance requires no code change. Use the
# plain "postgres://" DSN scheme (pgx/golang-migrate).
DATABASE_URL=postgres://postgres:postgres@localhost:5432/go_lang_template?sslmode=disable
DATABASE_MAX_CONNS=10
MIGRATIONS_PATH=migrations
